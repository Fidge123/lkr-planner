meta {
  name: ZEP CalDAV
}

script:pre-request {
  const { readKeychainJson, usesKeychain } = require("./lib/keychain.js");
  
  const credentials = usesKeychain(bru)
    ? readKeychainJson("lkr-planner-zep", "LKR Planner ZEP Admin")
    : { username: bru.getEnvVar("zepUsername"), password: bru.getEnvVar("zepPassword") };
  bru.setVar("username", credentials.username);
  bru.setVar("password", credentials.password);
}
