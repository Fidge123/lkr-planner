meta {
  name: ZEP CalDAV
}

script:pre-request {
  const { readApiEndpoints, readKeychainJson, usesKeychain } = require("./lib/keychain.js");
  
  if (usesKeychain(bru)) {
    const credentials = readKeychainJson("lkr-planner-zep", "LKR Planner ZEP Admin");
    bru.setVar("username", credentials.username);
    bru.setVar("password", credentials.password);
    bru.setVar("rootUrl", readApiEndpoints().zepCaldavRootUrl);
  } else {
    bru.setVar("username", bru.getEnvVar("zepUsername"));
    bru.setVar("password", bru.getEnvVar("zepPassword"));
    bru.setVar("rootUrl", bru.getEnvVar("zepCaldavRootUrl"));
  }
}
