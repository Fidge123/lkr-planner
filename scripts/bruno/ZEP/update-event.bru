meta {
  name: Update event
  type: http
  seq: 6
}

put {
  url: {{zepCalendarUrl}}{{eventUid}}.ics
  body: text
  auth: basic
}

headers {
  Content-Type: text/calendar; charset=utf-8
  If-Match: {{eventEtag}}
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

vars:pre-request {
  eventEtag: *
}

body:text {
  BEGIN:VCALENDAR
  VERSION:2.0
  PRODID:-//lkr-planner//EN
  BEGIN:VEVENT
  UID:{{eventUid}}
  DTSTAMP:20260501T120000Z
  DTSTART:20260506T100000
  DTEND:20260506T160000
  SUMMARY:Projekt Nord
  DESCRIPTION:daylite:/v1/projects/3001
  X-LKR-ORDER:1
  END:VEVENT
  END:VCALENDAR
}

script:pre-request {
  req.setBody(req.getBody().replace(/\r?\n/g, "\r\n"));
}

docs {
  Set `eventEtag` to the ETag from "Events in range" to reproduce the app's optimistic locking, the server answers HTTP 412 when it is stale.
}
