meta {
  name: List calendars
  type: http
  seq: 1
}

http {
  method: PROPFIND
  url: {{rootUrl}}
  body: xml
  auth: basic
}

headers {
  Depth: 1
  Content-Type: application/xml; charset=utf-8
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:xml {
  <?xml version="1.0" encoding="utf-8"?>
  <d:propfind xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">
    <d:prop>
      <d:displayname/>
      <d:resourcetype/>
    </d:prop>
  </d:propfind>
}
